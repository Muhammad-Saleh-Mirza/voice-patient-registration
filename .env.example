# ---------------------------------------------------------------------------
# Copy to `.env` for local development.  NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Database.
#   Local dev  -> SQLite file, zero setup.
#   Production -> Neon/Supabase Postgres connection string.
# The app normalises `postgres://` to `postgresql+psycopg2://` automatically,
# so you can paste a Neon/Render URL verbatim.
DATABASE_URL="postgresql://neondb_owner:npg_wi5sLgyldW9n@ep-super-bar-ar7ljvxy-pooler.c-4.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Shared secret sent by Vapi as the `x-vapi-secret` header on every tool call.
# Set the same value in the Vapi assistant's server config.
# Leave blank to disable the check (local dev only).
VAPI_SERVER_SECRET=

# Optional: where to write the structured conversation log.
# Defaults to stdout only, which is what Render/Railway capture.
LOG_FILE=

# Uvicorn port. Render injects this automatically.
PORT=8000
