{
  "_comment": [
    "Tool definitions for the Vapi assistant. Create these under Vapi -> Tools",
    "(or paste into the assistant's `model.tools` array via the API), replacing",
    "BASE_URL with your deployed service URL.",
    "",
    "All three point at the SAME endpoint, POST {BASE_URL}/vapi/tools. The server",
    "dispatches on the tool name. One webhook URL means one thing to configure",
    "and one thing to get wrong.",
    "",
    "`async: false` is essential — the agent must wait for the save to finish",
    "before telling the caller they are all set."
  ],
  "tools": [
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "lookup_patient",
        "description": "Check whether a patient already exists for a phone number. Call this once at the very start of every call, using the caller's number.",
        "parameters": {
          "type": "object",
          "properties": {
            "phone_number": {
              "type": "string",
              "description": "The caller's phone number, digits only or in any common format."
            }
          },
          "required": [
            "phone_number"
          ]
        }
      },
      "server": {
        "url": "BASE_URL/vapi/tools",
        "secret": "YOUR_VAPI_SERVER_SECRET",
        "timeoutSeconds": 20
      },
      "messages": [
        {
          "type": "request-start",
          "content": "One moment while I pull that up."
        }
      ]
    },
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "save_patient",
        "description": "Save a completed new patient registration. Call this ONLY after reading the full record back to the caller and hearing them confirm it is correct. Omit optional fields entirely if the caller did not provide them.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "description": "Patient's legal first name."
            },
            "last_name": {
              "type": "string",
              "description": "Patient's legal last name."
            },
            "date_of_birth": {
              "type": "string",
              "description": "Date of birth in MM/DD/YYYY format. Must not be in the future."
            },
            "sex": {
              "type": "string",
              "enum": [
                "Male",
                "Female",
                "Other",
                "Decline to Answer"
              ],
              "description": "Exactly one of the four allowed values."
            },
            "phone_number": {
              "type": "string",
              "description": "US 10-digit phone number."
            },
            "address_line_1": {
              "type": "string",
              "description": "Street address, e.g. '412 Marlowe Street'."
            },
            "city": {
              "type": "string",
              "description": "City name."
            },
            "state": {
              "type": "string",
              "description": "US state, two-letter abbreviation or full name."
            },
            "zip_code": {
              "type": "string",
              "description": "5-digit ZIP or ZIP+4."
            },
            "email": {
              "type": "string",
              "description": "Optional. Email address."
            },
            "address_line_2": {
              "type": "string",
              "description": "Optional. Apartment, suite or unit."
            },
            "insurance_provider": {
              "type": "string",
              "description": "Optional. Name of the insurance company."
            },
            "insurance_member_id": {
              "type": "string",
              "description": "Optional. Member or subscriber ID."
            },
            "preferred_language": {
              "type": "string",
              "description": "Optional. Defaults to English."
            },
            "emergency_contact_name": {
              "type": "string",
              "description": "Optional. Full name of emergency contact."
            },
            "emergency_contact_phone": {
              "type": "string",
              "description": "Optional. US 10-digit phone number."
            }
          },
          "required": [
            "first_name",
            "last_name",
            "date_of_birth",
            "sex",
            "phone_number",
            "address_line_1",
            "city",
            "state",
            "zip_code"
          ]
        }
      },
      "server": {
        "url": "BASE_URL/vapi/tools",
        "secret": "YOUR_VAPI_SERVER_SECRET",
        "timeoutSeconds": 20
      },
      "messages": [
        {
          "type": "request-start",
          "content": "Alright, saving that now."
        },
        {
          "type": "request-failed",
          "content": "I'm sorry, I'm having trouble reaching our system right now. Could you give me just a moment?"
        }
      ]
    },
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "update_patient",
        "description": "Update an existing patient record. Use only when lookup_patient returned status 'found' and the caller wants to change their details. Send patient_id plus only the fields that are changing.",
        "parameters": {
          "type": "object",
          "properties": {
            "patient_id": {
              "type": "string",
              "description": "The patient_id returned by lookup_patient."
            },
            "first_name": {
              "type": "string"
            },
            "last_name": {
              "type": "string"
            },
            "date_of_birth": {
              "type": "string",
              "description": "MM/DD/YYYY"
            },
            "sex": {
              "type": "string",
              "enum": [
                "Male",
                "Female",
                "Other",
                "Decline to Answer"
              ]
            },
            "phone_number": {
              "type": "string"
            },
            "address_line_1": {
              "type": "string"
            },
            "address_line_2": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "zip_code": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "insurance_provider": {
              "type": "string"
            },
            "insurance_member_id": {
              "type": "string"
            },
            "preferred_language": {
              "type": "string"
            },
            "emergency_contact_name": {
              "type": "string"
            },
            "emergency_contact_phone": {
              "type": "string"
            }
          },
          "required": [
            "patient_id"
          ]
        }
      },
      "server": {
        "url": "BASE_URL/vapi/tools",
        "secret": "YOUR_VAPI_SERVER_SECRET",
        "timeoutSeconds": 20
      }
    }
  ],
  "recommended_assistant_settings": {
    "_comment": "Settings that matter for how the call actually sounds.",
    "firstMessageMode": "assistant-speaks-first",
    "model": {
      "provider": "openai",
      "model": "gpt-4o",
      "temperature": 0.4,
      "_note": "Low temperature keeps field values verbatim. Higher values make the agent paraphrase the caller's data, which corrupts records."
    },
    "transcriber": {
      "provider": "deepgram",
      "model": "nova-2",
      "language": "en-US",
      "_note": "nova-2 handles spelled-out letters ('D-A-V-I-S') noticeably better than older models, which matters more here than raw WER."
    },
    "voice": {
      "provider": "11labs",
      "_note": "Any natural voice works. Avoid the robotic default presets."
    },
    "silenceTimeoutSeconds": 30,
    "maxDurationSeconds": 900,
    "endCallFunctionEnabled": true,
    "serverMessages": [
      "tool-calls",
      "end-of-call-report"
    ],
    "_serverMessages_note": "end-of-call-report is what populates the call_logs transcript column."
  }
}